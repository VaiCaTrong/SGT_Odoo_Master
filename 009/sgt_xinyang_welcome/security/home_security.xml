<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: group privilege (NOT res.groups.category_id) places this
         role under Settings -> Users -> Access Rights -> Home. -->
    <record id="module_category_sgt_home" model="ir.module.category">
        <field name="name">Home</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_sgt_home" model="res.groups.privilege">
        <field name="name">Home</field>
        <field name="category_id" ref="module_category_sgt_home"/>
        <field name="sequence">35</field>
        <field name="placeholder">No Home management rights</field>
        <field name="description">Manage the product showcase on the Xinyang Home app.</field>
    </record>
    <!-- Heat Map: separate privilege, so the right is given (or not) user by user. Home Managers inherit it. -->
    <record id="privilege_sgt_home_heatmap" model="res.groups.privilege">
        <field name="name">Heat Map</field>
        <field name="category_id" ref="module_category_sgt_home"/>
        <field name="sequence">36</field>
        <field name="placeholder">No Heat Map access</field>
        <field name="description">Open the XINYANG MAP (Heat Map) from the Home header.</field>
    </record>
    <record id="group_home_heatmap" model="res.groups">
        <field name="name">Heat Map Viewer</field>
        <field name="privilege_id" ref="privilege_sgt_home_heatmap"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">May open the Heat Map (customer map) from Home. Deals and Contacts still follow the user's own CRM rights.</field>
    </record>
    <!-- KPI Dashboard (Update_018): GB, Content, Data, Match Making. Home Managers inherit it. -->
    <record id="privilege_sgt_home_dashboard" model="res.groups.privilege">
        <field name="name">Dashboard</field>
        <field name="category_id" ref="module_category_sgt_home"/>
        <field name="sequence">37</field>
        <field name="placeholder">No Dashboard access</field>
        <field name="description">Open the main KPIs (GB, Content, Data, Match Making) from the Home header.</field>
    </record>
    <record id="group_home_dashboard" model="res.groups">
        <field name="name">Dashboard Viewer</field>
        <field name="privilege_id" ref="privilege_sgt_home_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">May open the KPI Dashboard from Home. Data and Match Making still follow the user's own CRM rights; GB and Content are the Xinyang project numbers from social360.</field>
    </record>
    <record id="group_home_manager" model="res.groups">
        <field name="name">Home Manager</field>
        <field name="privilege_id" ref="privilege_sgt_home"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_home_heatmap')), (4, ref('group_home_dashboard'))]"/>
        <field name="comment">May add, update, reorder, publish, archive and delete products on Home.</field>
    </record>
</odoo>
