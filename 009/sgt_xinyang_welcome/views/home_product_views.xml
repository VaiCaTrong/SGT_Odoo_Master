<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_sgt_home_product_list" model="ir.ui.view">
        <field name="name">sgt.home.product.list</field>
        <field name="model">sgt.home.product</field>
        <field name="arch" type="xml">
            <list string="Home products" default_order="sequence, id" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [56, 56]}"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="subtitle" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sgt_home_product_form" model="ir.ui.view">
        <field name="name">sgt.home.product.form</field>
        <field name="model">sgt.home.product</field>
        <field name="arch" type="xml">
            <form string="Home product">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Product name (English; globe icon for Vietnamese)..."/></h1>
                    </div>
                    <group>
                        <group string="Product details">
                            <field name="code" placeholder="XYPX / ZP100 / ZP200"/>
                            <field name="subtitle" placeholder="One short descriptive line"/>
                            <field name="category"/>
                        </group>
                        <group string="Publishing &amp; media">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="image" widget="image" options="{'size': [430, 430]}"/>
                        </group>
                    </group>
                    <group string="Extra images (shown under the main image when the product is opened)">
                        <field name="image_ids" nolabel="1" colspan="2" context="{'default_sequence': 10}">
                            <list editable="bottom" string="Extra images">
                                <field name="sequence" widget="handle"/>
                                <field name="image" widget="image" options="{'size': [96, 96]}"/>
                            </list>
                        </field>
                    </group>
                    <group string="Content shown when a visitor opens this product">
                        <field name="description" nolabel="1" colspan="2"
                               placeholder="Type the product content here: features, applications, notes. One line per feature. This text appears after a click on the product."/>
                    </group>
                    <group string="Internal notes — not published">
                        <field name="internal_note" nolabel="1" placeholder="Sources, verification notes, translation review..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sgt_home_product_search" model="ir.ui.view">
        <field name="name">sgt.home.product.search</field>
        <field name="model">sgt.home.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter name="shown" string="Shown on Home" domain="[('active', '=', True)]"/>
                <filter name="hidden" string="Hidden on Home" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Product category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sgt_home_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">sgt.home.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a product to the Home collection</p>
            <p>Upload an image, enter the product title, model code, subtitle and the content shown when the product is opened.
               Set "Show on Home" to publish; set it off to hide without deleting.
               Drag the handle in list view to change display order.</p>
        </field>
    </record>

    <menuitem id="menu_sgt_home_products" name="Products" parent="menu_sgt_home_root" action="action_sgt_home_product" sequence="5" groups="sgt_xinyang_welcome.group_home_manager,base.group_system"/>
</odoo>
