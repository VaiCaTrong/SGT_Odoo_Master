<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgt_home_setting_form" model="ir.ui.view">
        <field name="name">sgt.home.setting.form</field>
        <field name="model">sgt.home.setting</field>
        <field name="arch" type="xml">
            <form string="Home settings" create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1>Home settings</h1></div>
                    <group string="Product pictures">
                        <field name="autoplay_mode" widget="radio"/>
                        <field name="autoplay_custom_seconds" invisible="autoplay_mode != 'custom'"
                               required="autoplay_mode == 'custom'"/>
                        <field name="autoplay_seconds" readonly="1" invisible="autoplay_mode != 'custom'"/>
                    </group>
                    <div class="alert alert-warning" role="alert" groups="base.group_system" invisible="not heatmap_group_missing">
                        The Heat Map group does not exist in this database yet. Open Apps, find "XINYANG | UI-009 Login + Home" and
                        click Upgrade, then reload this page.
                    </div>
                    <field name="heatmap_group_missing" invisible="1" groups="base.group_system"/>
                    <group string="Heat Map access" groups="base.group_system">
                        <field name="heatmap_user_ids" widget="many2many_tags_avatar"
                               options="{'no_create': True, 'no_quick_create': True}"/>
                        <field name="heatmap_inherited_user_ids" widget="many2many_tags_avatar" readonly="1"/>
                    </group>
                    <div class="text-muted" groups="base.group_system">
                        Only the people listed here, the Home Managers and the Settings Administrators see the "Heat Map" item in
                        the Home menu. What each person sees on the map still follows their own CRM access rights.
                    </div>
                    <div class="alert alert-warning" role="alert" groups="base.group_system" invisible="not dashboard_group_missing">
                        The Dashboard Viewer group does not exist in this database yet. Open Apps, find "XINYANG | UI-009 Login + Home" and
                        click Upgrade, then reload this page.
                    </div>
                    <field name="dashboard_group_missing" invisible="1" groups="base.group_system"/>
                    <group string="KPI Dashboard access" groups="base.group_system">
                        <field name="dashboard_user_ids" widget="many2many_tags_avatar"
                               options="{'no_create': True, 'no_quick_create': True}"/>
                        <field name="dashboard_inherited_user_ids" widget="many2many_tags_avatar" readonly="1"/>
                    </group>
                    <div class="text-muted" groups="base.group_system">
                        Only the people listed here, the Home Managers and the Settings Administrators see the "Dashboard" item in the
                        Home menu. Data and Match Making follow each person's own CRM access rights.
                    </div>
                    <group string="KPI Dashboard · social360 (GB and Content)" groups="base.group_system">
                        <field name="kpi_sgt_active" widget="radio"/>
                    </group>
                    <group groups="base.group_system">
                        <group string="Connection 1 · main">
                            <field name="kpi_sgt_url" placeholder="https://sgt.sge.vn"/>
                            <field name="kpi_sgt_db"/>
                            <field name="kpi_sgt_login"/>
                            <field name="kpi_sgt_key" password="True"/>
                        </group>
                        <group string="Connection 2 · backup">
                            <field name="kpi_sgt2_url" placeholder="https://social360.sge.vn"/>
                            <field name="kpi_sgt2_db"/>
                            <field name="kpi_sgt2_login"/>
                            <field name="kpi_sgt2_key" password="True"/>
                        </group>
                    </group>
                    <div class="text-muted" groups="base.group_system">
                        GB and Content are read from social360 with a read-only account (nothing is written there). Both connections
                        are the same kind of Odoo; choose above which one "Update Data" reads, and switch when the other is down.
                        Only Settings Administrators can see or change these fields; the keys are never sent to the browser.
                        The Xinyang server must be allowed to reach the social360 addresses over HTTPS.
                    </div>
                    <group string="Saved data (GB and Content)" groups="base.group_system">
                        <field name="kpi_snapshot_note" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <group groups="base.group_system">
                        <field name="kpi_update_target" readonly="1" colspan="2"/>
                    </group>
                    <div groups="base.group_system">
                        <button name="action_kpi_update_data" type="object" string="Update Data" class="btn btn-primary"
                                confirm="Read the selected connection now (see 'Update Data will read' above): GB history (with every post URL), Content figures and the 9 latest approved posts with their first image. Save it all as a new version? The version in use stays available for Rollback. Nothing is written to the other system."/>
                    </div>
                    <field name="kpi_snapshot_ids" groups="base.group_system" readonly="1" nolabel="1">
                        <list string="Saved versions" create="false" delete="false" decoration-success="is_active" default_order="taken_at desc, id desc">
                            <field name="taken_at"/>
                            <field name="taken_by_id"/>
                            <field name="connection"/>
                            <field name="source"/>
                            <field name="gb_total"/>
                            <field name="content_total"/>
                            <field name="content_approved"/>
                            <field name="posts_total"/>
                            <field name="is_active" widget="boolean" string="In use"/>
                            <button name="action_use_version" type="object" string="Rollback" class="btn btn-sm btn-secondary"
                                    invisible="is_active"
                                    confirm="Show this saved version on the Dashboard instead of the one in use? Nothing is deleted."/>
                        </list>
                    </field>
                    <div class="text-muted" groups="base.group_system">
                        Every "Update Data" saves a new version (the last 10 are kept). The Dashboard shows the version in use, so GB and
                        Content keep working when social360 is down. "Rollback" on an older row shows that older data again; on a newer
                        row it brings that newer data back. Nothing is deleted by switching.
                    </div>
                    <div class="text-muted">
                        When a product has several pictures, the popup changes the picture by itself with this delay.
                        The change pauses while the pointer is over the picture. Products with a single picture show no
                        picture buttons. More Home settings will be added on this page.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sgt_home_setting" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">sgt.home.setting</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="ref('sgt_xinyang_welcome.home_setting_default')"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_sgt_home_settings" name="Settings" parent="menu_sgt_home_root" action="action_sgt_home_setting"
              sequence="30" groups="sgt_xinyang_welcome.group_home_manager,base.group_system"/>
</odoo>
