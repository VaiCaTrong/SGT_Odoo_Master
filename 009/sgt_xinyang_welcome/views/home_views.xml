<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============ Banner slides ============ -->
    <record id="view_sgt_home_slide_list" model="ir.ui.view">
        <field name="name">sgt.home.slide.list</field>
        <field name="model">sgt.home.slide</field>
        <field name="arch" type="xml">
            <list string="Banner slides" editable="bottom" default_order="sequence, id" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tag"/>
                <field name="theme"/>
                <field name="button_label"/>
                <field name="active" widget="boolean_toggle" string="Show on Home"/>
            </list>
        </field>
    </record>

    <record id="view_sgt_home_slide_form" model="ir.ui.view">
        <field name="name">sgt.home.slide.form</field>
        <field name="model">sgt.home.slide</field>
        <field name="arch" type="xml">
            <form string="Banner slide">
                <sheet>
                    <group>
                        <group string="Text">
                            <field name="name"/>
                            <field name="tag"/>
                            <field name="text"/>
                            <field name="theme"/>
                        </group>
                        <group string="Button and order">
                            <field name="button_label"/>
                            <field name="button_url" placeholder="https://..."/>
                            <field name="sequence"/>
                            <field name="active" string="Show on Home"/>
                        </group>
                    </group>
                    <group string="Picture (optional, 960 x 560 px)">
                        <field name="image" widget="image" options="{'size': [480, 280]}" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sgt_home_slide_search" model="ir.ui.view">
        <field name="name">sgt.home.slide.search</field>
        <field name="model">sgt.home.slide</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tag"/>
                <filter string="Shown on Home" name="shown" domain="[('active', '=', True)]"/>
                <filter string="Hidden" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sgt_home_slide" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">sgt.home.slide</field>
        <field name="view_mode">list,form</field>
        <!-- Hidden banners stay in the list (greyed out) so they can be switched back on with one click. -->
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a banner</p>
            <p>Switch "Show on Home" off to hide a banner for now; switch it on again whenever you need it.</p>
        </field>
    </record>

    <!-- ============ Highlight cards ============ -->
    <record id="view_sgt_home_fact_list" model="ir.ui.view">
        <field name="name">sgt.home.fact.list</field>
        <field name="model">sgt.home.fact</field>
        <field name="arch" type="xml">
            <list string="Highlights" editable="bottom" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="value"/>
                <field name="name"/>
                <field name="accent"/>
                <field name="source"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sgt_home_fact_search" model="ir.ui.view">
        <field name="name">sgt.home.fact.search</field>
        <field name="model">sgt.home.fact</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="value"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sgt_home_fact" model="ir.actions.act_window">
        <field name="name">Highlights</field>
        <field name="res_model">sgt.home.fact</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a highlight card</p>
            <p>Cards appear under the banner on the Home page. With no card, that block is hidden.
            Only enter facts you can source (company website, official documents).</p>
        </field>
    </record>

    <!-- ============ Home page (client action) + menus ============ -->
    <record id="action_sgt_home" model="ir.actions.client">
        <field name="name">Home</field>
        <field name="tag">sgt_xinyang_home</field>
    </record>

    <!-- Lowest sequence = first app = where /odoo lands after login. No groups = every user. -->
    <menuitem id="menu_sgt_home_root" name="Home" action="action_sgt_home" sequence="-100" web_icon="sgt_xinyang_welcome,static/description/icon.png"/>
    <menuitem id="menu_sgt_home_slides" name="Banners" parent="menu_sgt_home_root" action="action_sgt_home_slide" sequence="10" groups="base.group_system"/>
    <menuitem id="menu_sgt_home_facts" name="Highlights" parent="menu_sgt_home_root" action="action_sgt_home_fact" sequence="20" groups="base.group_system"/>
</odoo>
