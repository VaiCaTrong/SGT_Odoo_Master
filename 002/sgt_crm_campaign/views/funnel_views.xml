<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================== Phân quyền (department) -->
    <record id="view_crm002_funnel_permission_list" model="ir.ui.view">
        <field name="name">sgt.crm002.funnel.permission.list</field>
        <field name="model">sgt.crm002.funnel</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="group_key" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="allowed_department_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </list>
        </field>
    </record>
    <record id="view_crm002_funnel_search" model="ir.ui.view">
        <field name="name">sgt.crm002.funnel.search</field>
        <field name="model">sgt.crm002.funnel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Đã lưu trữ" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Nhóm phễu" name="group_group" context="{'group_by': 'group_key'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_crm002_permissions" model="ir.actions.act_window">
        <field name="name">CRM-002 Phân quyền phễu (Department)</field>
        <field name="res_model">sgt.crm002.funnel</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_crm002_funnel_permission_list"/>
        <field name="search_view_id" ref="view_crm002_funnel_search"/>
        <field name="context">{'search_default_group_group': 1}</field>
    </record>

    <!-- ===================================================== Cài đặt (funnel, stage) -->
    <record id="view_crm002_funnel_list" model="ir.ui.view">
        <field name="name">sgt.crm002.funnel.list</field>
        <field name="model">sgt.crm002.funnel</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="group_key"/>
                <field name="code" optional="hide"/>
                <field name="filter_mode" optional="show"/>
                <field name="tag_id" optional="show"/>
                <field name="source_id" optional="show"/>
                <field name="rule_count" string="Số luật bàn giao"/>
            </list>
        </field>
    </record>
    <record id="view_crm002_funnel_form" model="ir.ui.view">
        <field name="name">sgt.crm002.funnel.form</field>
        <field name="model">sgt.crm002.funnel</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_rules" type="object" class="oe_stat_button"
                                icon="fa-exchange" invisible="not id">
                            <field name="rule_count" widget="statinfo" string="Luật bàn giao"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên phễu mới"
                                   readonly="id and group_key != 'data'"/></h1>
                    </div>
                    <group>
                        <group string="Phễu">
                            <field name="group_key" readonly="1"/>
                            <field name="code" readonly="1" invisible="not id"/>
                            <field name="is_main" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Deal vào phễu như thế nào" invisible="group_key != 'data'">
                            <field name="filter_mode"/>
                            <field name="tag_id" invisible="filter_mode != 'tag'"/>
                            <field name="source_id" invisible="filter_mode != 'source'"/>
                            <field name="initial_tag_name" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stage (cột)" name="stages">
                            <div class="alert alert-info" role="status" invisible="group_key != 'mm'">
                                Match Making dùng Stage của CRM Pipeline (CRM &gt; Cấu hình &gt; Stages), không cấu hình ở đây.
                            </div>
                            <div class="alert alert-info" role="status" invisible="group_key != 'data'">
                                Data Funnel luôn có 3 cột cố định 1.Data / 2.Verified / 3.Potential.
                            </div>
                            <field name="stage_ids" invisible="group_key == 'mm'" readonly="group_key != 'sale'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phân quyền Department" name="departments">
                            <field name="allowed_department_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_crm002_funnel_config" model="ir.actions.act_window">
        <field name="name">CRM-002 Cài đặt phễu</field>
        <field name="res_model">sgt.crm002.funnel</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_crm002_funnel_list"/>
        <field name="search_view_id" ref="view_crm002_funnel_search"/>
        <field name="context">{'default_group_key': 'data', 'search_default_group_group': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phễu</p>
            <p>Phễu mới chỉ tạo được trong Data Funnel. Phễu Sale (New, Renew) và Match Making là cố định.</p>
        </field>
    </record>

    <!-- ===================================================== Luật bàn giao -->
    <record id="view_crm002_rule_list" model="ir.ui.view">
        <field name="name">sgt.crm002.handoff.rule.list</field>
        <field name="model">sgt.crm002.handoff.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="summary"/>
                <field name="pending_count" string="Deal đang chờ ở cột nguồn"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_apply_existing" type="object" string="Áp dụng cho Deal đang có"
                        icon="fa-share" invisible="not active"
                        confirm="Bàn giao TOÀN BỘ Deal đang nằm ở cột nguồn sang cột đích?"/>
            </list>
        </field>
    </record>
    <record id="view_crm002_rule_form" model="ir.ui.view">
        <field name="name">sgt.crm002.handoff.rule.form</field>
        <field name="model">sgt.crm002.handoff.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_existing" type="object" class="btn-primary"
                            string="Áp dụng cho Deal đang có" invisible="not id or not active"
                            confirm="Bàn giao TOÀN BỘ Deal đang nằm ở cột nguồn sang cột đích? Cùng một Deal, log note và chatter được giữ nguyên."/>
                </header>
                <sheet>
                    <div class="oe_title"><h2><field name="summary"/></h2></div>
                    <group>
                        <group string="Khi Deal đi vào cột…">
                            <field name="source_group" invisible="1"/>
                            <field name="source_funnel_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="source_stage_id" domain="[('funnel_id', '=', source_funnel_id)]"
                                   invisible="not source_funnel_id or source_group == 'mm'"
                                   required="source_group in ('data', 'sale')"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="source_crm_stage_id" invisible="source_group != 'mm'"
                                   required="source_group == 'mm'"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="…thì bàn giao sang cột">
                            <field name="target_group" invisible="1"/>
                            <field name="target_funnel_id" domain="[('group_key', '!=', 'data'), ('id', '!=', source_funnel_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="target_stage_id" domain="[('funnel_id', '=', target_funnel_id)]"
                                   invisible="not target_funnel_id or target_group == 'mm'"
                                   required="target_group == 'sale'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="target_crm_stage_id" invisible="target_group != 'mm'"
                                   required="target_group == 'mm'"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="pending_count" string="Deal đang chờ ở cột nguồn" invisible="not id"/>
                    </group>
                    <div class="text-muted">
                        Bàn giao dùng CHÍNH Deal đó (không tạo bản sao) nên log note, email, hoạt động, Tag và Salesperson được giữ nguyên.
                        Mỗi luật chỉ chạy một lần cho mỗi Deal và không kéo Deal lùi.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_crm002_rule_search" model="ir.ui.view">
        <field name="name">sgt.crm002.handoff.rule.search</field>
        <field name="model">sgt.crm002.handoff.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_funnel_id"/>
                <field name="target_funnel_id"/>
                <filter string="Đã tắt" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_crm002_rules" model="ir.actions.act_window">
        <field name="name">CRM-002 Luật bàn giao</field>
        <field name="res_model">sgt.crm002.handoff.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm002_rule_search"/>
    </record>
</odoo>
