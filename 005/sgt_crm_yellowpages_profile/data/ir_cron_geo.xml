<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Extension create/write only queues the lead; Odoo cron calls the provider. -->
  <record id="ir_cron_crm005_geolocate_leads" model="ir.cron">
    <field name="name">CRM-005: Định vị Deal chờ xử lý</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <field name="state">code</field>
    <field name="code">model._cron_crm005_geolocate_pending()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
